  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "sharp": "^0.35.5",
